{
  "name": "misstype-wasm",
  "version": "0.2.0",
  "description": "Browser WebAssembly bindings for the Misstype Zhuyin input engine, plus a drop-in layer that enables it on any page's text fields",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./enable": "./src/enable.js",
    "./embed": "./src/embed.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "bopomofo",
    "zhuyin",
    "ime",
    "wasm",
    "input-method"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  }
}
