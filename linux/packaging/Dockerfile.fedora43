# Pre-baked Fedora 43 packaging and verification image for release.yml.
FROM fedora:43
RUN dnf install -y \
      git gcc gcc-c++ cmake make pkgconf-pkg-config extra-cmake-modules gettext python3 curl xz \
      fcitx5 fcitx5-devel gtk4-devel rpm-build fcitx5-configtool fcitx5-gtk fcitx5-qt \
      ibus ibus-devel glib2-devel xorg-x11-server-Xvfb dbus-x11 dbus-daemon \
    && dnf clean all
